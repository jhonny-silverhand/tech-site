# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# Full walkthroughs for every value below live in /Guides.

# --- Supabase (Guides/01-database-setup.md) ---
# Public — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server only, never prefix with NEXT_PUBLIC_. Used by /api/admin/* routes
# to bypass Row Level Security so the admin can manage every user's posts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login (Guides/00-how-to-run.md) ---
# The single admin account described in the project spec. Generate the value with:
#   npm run hash-password -- "your-real-password"
# (Printed pre-encoded as base64 — that's deliberate, see the comment in
# scripts/hash-password.mjs. Paste the base64 string exactly as printed.)
ADMIN_EMAIL=admin@tech-site.local
ADMIN_PASSWORD_HASH_B64=
# Random long string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- AI drafting (Guides/02-api-setup.md) ---
# Free key from https://aistudio.google.com/apikey — used only by the admin's
# "Generate draft" button. Regular users never touch this.
GEMINI_API_KEY=

# --- Shopping Intelligence Providers (Guides/03-shopping-setup.md) ---
# Amazon India PA-API 5.0 (requires Amazon Associates India approval + 10 sales/30 days)
# https://affiliate-program.amazon.in
AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PA_API_PARTNER_TAG=
AMAZON_PA_API_REGION=us-east-1

# Flipkart Affiliate API
# https://affiliate.flipkart.com
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Croma (via Apify Actor API - no official API available)
# https://apify.com/sian.agency/croma-product-scraper
CROMA_APIFY_TOKEN=

# Reliance Digital (via Apify Actor API - no official API available)
# https://apify.com/sian.agency/reliance-digital-product-scraper
# Affiliate program via Cuelinks: https://www.cuelinks.com/campaigns/reliance-digital-affiliate-program
RELIANCE_DIGITAL_APIFY_TOKEN=

# Currency Conversion
# ExchangeRate-API (free tier: 1500 requests/month)
# https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=